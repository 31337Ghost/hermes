upstream chrome_cdp {
    server host.docker.internal:${CDP_HOST_PORT};
    keepalive 8;
    keepalive_requests 1000;
    keepalive_time 1h;
}

server {
    listen 9223;
    server_tokens off;

    # CDP discovery (HTTP JSON) — keepalive + переписать ws-URL
    location ~* ^/json {
        proxy_pass http://chrome_cdp;
        proxy_http_version 1.1;
        proxy_set_header Host localhost:${CDP_HOST_PORT};
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout    30s;
        proxy_send_timeout    30s;

        sub_filter_once off;
        sub_filter_types application/json;
        sub_filter 'ws://localhost:${CDP_HOST_PORT}'  'ws://cdp-proxy:9223';
        sub_filter 'ws://127.0.0.1:${CDP_HOST_PORT}'  'ws://cdp-proxy:9223';
    }

    # WebSocket CDP туннель — без sub_filter, без буферизации
    location / {
        proxy_pass http://host.docker.internal:${CDP_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host localhost:${CDP_HOST_PORT};
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
    }
}
