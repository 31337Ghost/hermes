# Unique per clone/deployment (for example hermes-katya or hermes-olga)
COMPOSE_PROJECT_NAME=hermes-agent-name

# Ports
GATEWAY_PORT=8642
DASHBOARD_PORT=9119
CDP_HOST=host.docker.internal
CDP_HOST_PORT=9222

# Gateway / API
API_SERVER_KEY=

# Optional headful Chromium browser (make browser-up)
BROWSER_IMAGE=lscr.io/linuxserver/chromium@sha256:4c7b9086d2e5054b61c9e6b0f75efceece5befeff2bec3ff543d52e000cee21d
BROWSER_USER=
BROWSER_PASSWORD=
BROWSER_PROXY_URL=http://proxy-host:8080
BROWSER_BIND_HOST=127.0.0.1
# Required and unique per browser deployment
BROWSER_HTTPS_PORT=13001
BROWSER_PROFILE_DIR=./browser-data/hermes-agent-name
BROWSER_PUID=1000
BROWSER_PGID=1000
BROWSER_MEMORY_LIMIT=2g
BROWSER_CPUS=2.0
BROWSER_SHM_SIZE=2gb
TZ=Etc/UTC
